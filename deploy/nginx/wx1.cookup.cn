server {
    listen 80;
    listen [::]:80;
    server_name wx1.cookup.cn;
    return 301 https://wx1.cookup.cn$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name wx1.cookup.cn;
    ssl_certificate /etc/letsencrypt/live/cookup.cn/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/cookup.cn/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    server_tokens off;
    # 与服务端上传上限一致
    client_max_body_size 20m;
    add_header X-Content-Type-Options nosniff always;
    access_log /var/log/nginx/wx1.access.log;
    error_log /var/log/nginx/wx1.error.log;

    # 管理接口只允许在服务器本机通过 127.0.0.1:1240 调用
    location ^~ /api/v1/admin/ {
        return 403;
    }

    # API 与面板由同一服务提供
    location / {
        proxy_pass http://127.0.0.1:1240;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        proxy_read_timeout 90s;
        proxy_send_timeout 90s;
    }
}
