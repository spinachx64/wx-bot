[Unit]
Description=WeChat official account API service
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=wxbot
Group=wxbot
WorkingDirectory=/opt/wx-bot/current
# WXBOT_MASTER_KEY / WXBOT_ADMIN_TOKEN / DATA_DIR / LISTEN_ADDR
# 旧的 GZH_APPID / GZH_SECRET / GZH_TOKEN 启动时迁移为 default 租户
EnvironmentFile=/opt/project-config/wx-bot/service.env
ExecStart=/opt/wx-bot/current/wx-bot
Environment=TZ=Asia/Shanghai
Restart=on-failure
RestartSec=3
TimeoutStopSec=15
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
# SQLite 数据库和租户图片目录
ReadWritePaths=/opt/wx-bot/data
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
